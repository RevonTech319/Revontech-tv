rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════════════
    //  HELPERS
    // ════════════════════════════════════════════════════════════════════════

    // SECURE — admin status comes ONLY from the admins collection.
    // The previous email-pattern check was a CRITICAL hole: anyone who
    // signed up with a non-@chtv.app email was automatically admin.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Only the referral-system fields may be written by any authenticated
    // user (used when creditReferrerOnSignup updates the referrer's profile)
    // Note: Cloud Functions bypass these rules and have admin privileges
    function isReferralFieldUpdate() {
      let allowed = ['referral_count', 'reward_claimed', 'plan', 'is_active', 'pending_commissions', 'referral_reward_days', 'referral_paid_count', 'expires_at', 'referred_buyers'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ════════════════════════════════════════════════════════════════════════
    //  ADMINS — self-bootstrap allowed for non-phone email accounts
    //
    //  The admin app auto-creates admins/{uid} on first successful sign-in
    //  by an account whose email does NOT end with @chtv.app (those are
    //  reserved for phone-auth users). The optional Firestore allowlist
    //  at settings/admin_config.admin_emails is enforced in the admin
    //  client itself.
    // ════════════════════════════════════════════════════════════════════════
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);

      // Self-bootstrap own admin doc — only if your email isn't a phone-auth
      // synthetic email. Phone-auth users CANNOT elevate themselves.
      allow create, update: if isSignedIn()
        && request.auth.uid == adminId
        && request.auth.token.email != null
        && !request.auth.token.email.matches('.*@chtv[.]app');

      // Only an existing admin can delete an admin record
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  PROFILES
    // ════════════════════════════════════════════════════════════════════════
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn(); // needed for referral_code lookups

      // Own profile: full write
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Cross-user referral update (any signed-in user, but ONLY referral fields)
      allow update: if isSignedIn()
                    && request.auth.uid != userId
                    && isReferralFieldUpdate();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  USERS (legacy collection)
    // ════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow list:  if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  SUBSCRIPTIONS
    //  Note: Cloud Functions (running with admin privileges) can update
    //  referral_credited, referral_commission_amount, and 
    //  referral_commission_percentage fields automatically
    // ════════════════════════════════════════════════════════════════════════
    match /subscriptions/{docId} {
      allow read: if isSignedIn() &&
                     (resource == null ||
                      resource.data.user_id == request.auth.uid ||
                      isAdmin());

      allow list: if isSignedIn();

      // Self-create at payment time OR admin manually grants a package
      allow create: if isAdmin()
                     || (isSignedIn() &&
                        request.resource.data.user_id == request.auth.uid);

      // Cross-user create — referral reward only (free 1-day subscription
      // granted by creditReferrerOnSignup)
      allow create: if isSignedIn() &&
                       request.resource.data.gateway == 'referral' &&
                       request.resource.data.amount   == 0          &&
                       request.resource.data.status   == 'active';

      // Owner can update own subscription; admin always
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid)
                    || isAdmin();

      // Cross-user update of referral subscriptions (extending expires_at)
      allow update: if isSignedIn() &&
                       resource.data.gateway == 'referral' &&
                       resource.data.amount  == 0;

      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  USER NOTIFICATIONS
    // ════════════════════════════════════════════════════════════════════════
    match /user_notifications/{docId} {
      allow read: if (isSignedIn() &&
                      (resource == null ||
                       resource.data.user_id == request.auth.uid))
                  || isAdmin();
      allow list:  if isAdmin();
      allow write: if (isSignedIn() &&
                       request.resource.data.user_id == request.auth.uid)
                  || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  PUBLIC READ-ONLY COLLECTIONS — admin-only writes
    // ════════════════════════════════════════════════════════════════════════
    match /channels/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /channel_programs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /slider_images/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tokens/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // API keys for external websites (document id = SHA-256 of the key).
    // Admin only – the Cloud Function reads them with admin privileges.
    match /api_keys/{keyId} {
      allow read, write: if isAdmin();
    }
    match /movies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    //  DEFAULT DENY — anything not matched above is forbidden
    // ════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
