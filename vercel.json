
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/api/v1/:path*",
          "destination": "/api/token-api?__p=/v1/:path*"
        },
        {
          "source": "/api/v2/:path*",
          "destination": "/api/token-api?__p=/v2/:path*"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "admin": {
      "root": "admin",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "same-origin"
            }
          ]
        },
        {
          "source": "/admin/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/admin/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/fastlipa/:match*",
      "destination": "https://api.fastlipa.com/:match*"
    },
    {
      "source": "/api/palmpesa/:match*",
      "destination": "https://palmpesa.drmlelwa.co.tz/:match*"
    },
    {
      "source": "/api/sonicpesa/:match*",
      "destination": "https://api.sonicpesa.com/api/v1/:match*"
    },
    {
      "source": "/api/snippe/:match*",
      "destination": "https://api.snippe.sh/:match*"
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
