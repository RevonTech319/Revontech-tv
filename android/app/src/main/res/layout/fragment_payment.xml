<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scroll_payment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vifurushi vya VIP Premium"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chagua kifurushi kisha ufanye malipo kutazama njia zote bila kikomo"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <!-- Plans RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />



        </LinearLayout>
    </ScrollView>

    <!-- 1. Waiting Overlay Container (USSD Push Polling) -->
    <LinearLayout
        android:id="@+id/container_waiting_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6030408"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminateTint="@color/accent_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Kamilisha Malipo"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Tafadhali angalia simu yako na uweke PIN kuthibitisha malipo kwenye skrini ya USSD inayotokea."
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/tv_waiting_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tafadhali subiri sekunde 60..."
            android:textColor="@color/accent_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_cancel_waiting"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Ghairi na Ujaze Mwenyewe"
            android:textColor="#EF4444"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 2. Success Overlay Container -->
    <LinearLayout
        android:id="@+id/container_success_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2030408"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Checkmark Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#10B981"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/checkbox_on_background"
                android:tint="@color/white"
                android:padding="20dp"
                android:contentDescription="Success checkmark" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Malipo Yamefanikiwa!"
            android:textColor="#10B981"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Hongera! Kifurushi chako cha VIP Premium sasa kiko hai. Unaweza kuanza kutazama vituo vyote."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btn_success_ok"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#10B981"
            android:text="ANZA KUTAZAMA"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 3. Failure Overlay Container -->
    <LinearLayout
        android:id="@+id/container_failure_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2030408"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Cross Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#EF4444"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_delete"
                android:tint="@color/white"
                android:padding="20dp"
                android:contentDescription="Failure cross" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Malipo Yameshindwa!"
            android:textColor="#EF4444"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Muda wa kusubiri malipo umeisha au muamala umeghairiwa. Tafadhali jaribu tena au wasiliana na usaidizi."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btn_failure_retry"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#EF4444"
            android:text="JARIBU TENA"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
