<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Native ExoPlayer PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="always"
        app:resize_mode="fit" />

    <!-- Simple loading state overlaid on player -->
    <ProgressBar
        android:id="@+id/player_loader"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

    <!-- Top Overlay Bar (Back, LIVE, Countdown) -->
    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/player_top_gradient">

        <!-- Native Swahili Back Button overlay -->
        <LinearLayout
            android:id="@+id/btn_player_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/player_btn_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Rudi"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right badges (LIVE and trial countdown) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Trial timer text -->
            <TextView
                android:id="@+id/tv_trial_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="30s"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_trial_bg"
                android:visibility="gone" />

            <!-- LIVE badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_live_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:gravity="center"
                android:layout_marginEnd="12dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@android:color/white"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Volume Mute/Unmute button -->
            <LinearLayout
                android:id="@+id/btn_player_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/player_btn_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/img_player_volume"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="@color/white" />
            </LinearLayout>

            <!-- Settings button -->
            <LinearLayout
                android:id="@+id/btn_player_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/player_btn_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Settings Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settings_overlay"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#F205050A"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mipangilio ya Player"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Audio track options title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lugha ya Sauti (Audio)"
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_audio_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- Subtitle options title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manukuu (Subtitles)"
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/container_text_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Paywall Screen Overlay -->
    <ScrollView
        android:id="@+id/paywall_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA030408"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Paywall Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_gravity="center"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="#66FFB800"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Crown logo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="32dp"
                        app:cardBackgroundColor="#1AFFB800"
                        app:strokeColor="@color/accent_gold"
                        app:strokeWidth="2dp"
                        android:layout_marginBottom="16dp">
                        
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/btn_star_big_on"
                            android:tint="@color/accent_gold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muda wa Majaribio Umeisha"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kituo hiki ni cha kulipia. Jiunge sasa ili upate access ya vipindi vyote vya kimataifa bila kikomo."
                        android:textColor="@color/gray_text"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="20dp" />

                    <!-- Plan Pricing List -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp"
                        android:divider="?android:attr/dividerHorizontal"
                        android:showDividers="middle">

                        <!-- Plan Item 1 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="16dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/plan_item_bg">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Siku 1"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,000 TZS"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <!-- Plan Item 2 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="16dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/plan_item_bg">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wiki 1"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,500 TZS"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <!-- Plan Item 3 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="16dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/plan_item_bg">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wiki 2"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5,000 TZS"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>

                        <!-- Plan Item 4 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="16dp"
                            android:background="@drawable/plan_item_bg">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mwezi 1"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10,000 TZS"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- Subscribe button -->
                    <Button
                        android:id="@+id/btn_paywall_subscribe"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/accent_gold"
                        android:text="LIPIA SASA"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Go back button -->
                    <Button
                        android:id="@+id/btn_paywall_back"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:text="Rudi Nyuma"
                        android:textColor="@color/gray_text" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
